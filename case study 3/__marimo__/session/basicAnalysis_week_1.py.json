          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"define-and-implement-the-objective-function\">Define and implement the objective function</h3>\n<span class=\"paragraph\">We want to minimize the total network costs (variable costs + fixed costs):</span>\n<marimo-tex class=\"arithmatex\">||[\\min \\sum_{i\\in W}\\sum_{j\\in R} x_{ij} c_{ij} + \\sum_{i\\in W} f_i y_i||]</marimo-tex></span>"
          }
        }
      ],
      "console": []
